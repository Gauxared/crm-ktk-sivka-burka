{
  "id": "PIPE-004",
  "title": "Validation, review, retry and escalation",
  "type": "bootstrap",
  "status": "BACKLOG",
  "priority": "high",
  "executor": {
    "preferred": "cloud",
    "fallback": "cloud"
  },
  "reviewer": "cloud",
  "depends_on": [
    "PIPE-003"
  ],
  "allowed_paths": [
    "scripts/**",
    "tests/pipeline/**",
    "docs/**"
  ],
  "forbidden_paths": [],
  "context": [
    "docs/development-pipeline.md"
  ],
  "requirements": [
    "Enforce passing checks and current review before merge; limit local attempts"
  ],
  "acceptance": [
    "Requirements satisfied; validation passes; cloud review PASS"
  ],
  "validation": [
    {
      "name": "pipeline tests",
      "argv": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/pipeline",
        "-v"
      ],
      "timeout": 120
    }
  ],
  "risk": "medium",
  "retry_limit": 1
}
