# Development-only PostgreSQL values. Copy this file to .env before Docker commands.
APP_ENV=development
POSTGRES_DB=sivka_dev
POSTGRES_USER=sivka_dev
POSTGRES_PASSWORD=development-only-change-before-any-shared-environment
POSTGRES_PORT=54329
DATABASE_URL=postgresql+psycopg://sivka_dev:development-only-change-before-any-shared-environment@127.0.0.1:54329/sivka_dev

# Required only when APP_ENV=production. Never put real values in this example.
SESSION_SECRET=
ADMIN_BOOTSTRAP_LOGIN=

# Optional and unrelated to the application runtime: retained for separate local-model experiments.
LOCAL_LLM_BASE_URL=http://127.0.0.1:6996/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_CONTEXT_LIMIT=16384
LOCAL_LLM_MAX_OUTPUT=4096
LOCAL_LLM_TIMEOUT=180
LOCAL_LLM_REASONING_EFFORT=off
